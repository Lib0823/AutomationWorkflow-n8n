              "value": "={{\nJSON.stringify({\n  \"object_type\": \"text\",\n  \"text\": \"#\" +$now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd') + \" 경제 뉴스\\n\" + \n          \"━━━━━━━━━━━━━━━━━━\\n\\n\" + \n          JSON.parse($json.content.parts[0].text.replace(/```json|```/g, \"\")).map(item => {\n            return `${item.title}\\n\\n📝요약: ${item.description}\\n\\n🔗 ${item.link}`\n          }).join('\\n\\n' + '--------------------------' + '\\n\\n'),\n  \"link\": {\n    \"web_url\": \"\", \n    \"mobile_web_url\": \"\"\n  }\n})\n}}"
            }
